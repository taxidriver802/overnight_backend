# Copy to `.env` and fill secrets. Never commit `.env`.

NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/overnight_dev?schema=public"
LOG_LEVEL=info

# Must be >= 32 characters (HS256 interim; migrate to EdDSA before production per BUILD_PLAN)
JWT_ACCESS_SECRET="replace-with-at-least-32-character-secret!!!!!!!!"
JWT_ACCESS_EXPIRES_SEC=600
REFRESH_TOKEN_DAYS=30
BCRYPT_COST=12
LOCKOUT_WINDOW_MINUTES=15
LOCKOUT_DURATION_MINUTES=30
MAX_PIN_ATTEMPTS=5
